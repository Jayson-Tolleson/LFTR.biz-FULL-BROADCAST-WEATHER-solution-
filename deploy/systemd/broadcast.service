[Unit]
Description=Broadcast API Service
After=network.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_GROUP}
WorkingDirectory=/home/jayson_tolleson/broadcast
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=${CFG_DIR}/google.env
ExecStart=/home/jayson_tolleson/broadcast/venv/bin/hypercorn server.gfs_service:app --bind 127.0.0.1:8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
