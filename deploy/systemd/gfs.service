[Unit]
Description=GFS Backend Service
After=network.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_GROUP}
WorkingDirectory=${APP_DIR}
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=${CFG_DIR}/google.env
ExecStart=${VENV_DIR}/bin/python gfs.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
